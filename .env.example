# Copia este archivo a .env y llena tus valores reales. NUNCA subas .env a git.

# --- WhatsApp Cloud API (de tu app en Meta for Developers) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Numero interno para avisos de escalado (NO se comparte, NUNCA se le pasa al LLM) ---
NOTIFY_NUMBER=

# --- Proveedor de LLM: "anthropic" o "openai_compatible" ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Si LLM_PROVIDER=openai_compatible, llena estos en vez de ANTHROPIC_API_KEY
# (sirve para Nvidia NIM, OpenRouter, Kimi, o cualquier endpoint compatible con OpenAI):
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- Opcional ---
# ESCALATED_REPLY="Ya avisamos a alguien del equipo, en breve te contactan por aqui mismo."
# DB_PATH=./bot.db
